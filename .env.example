# Fuente de datos de la capa de servicios (src/services/index.ts)
#   mock  → implementación en memoria sobre src/mocks (por defecto, el prototipo funciona sin backend)
#   http  → src/services/http/* contra la API real (hoy cada método lanza NotImplementedError)
NEXT_PUBLIC_DATA_SOURCE=mock

# URL base de la API cuando NEXT_PUBLIC_DATA_SOURCE=http (ver src/services/http/client.ts)
NEXT_PUBLIC_API_URL=http://localhost:4000
